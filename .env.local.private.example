AIOS_ENV=local_developer
AIOS_PRESENTATION_MODE=true
AIOS_LOCAL_ONLY=true
AIOS_ALLOW_GITHUB_PUSH=false
AIOS_PUBLIC_RELEASE=false
AIOS_DATABASE_URL=sqlite:///./aios_local_private.db
AIOS_RUNTIME_PROVIDER=auto
AIOS_CHAT_PROVIDER=codex_cli_local_developer
AIOS_ALLOW_CODEX_CLI_RUNTIME=true
AIOS_CODEX_CLI_MODEL=gpt-5.5
AIOS_NATIVE_RUNTIME_ENABLED=true
AIOS_NATIVE_RUNTIME_MODEL=aios-native-fabric-v1
AIOS_ALLOW_OPENAI_API_RUNTIME=true
AIOS_REQUIRE_APPROVAL_GATE=true
AIOS_SECRET_STORAGE=env_or_os_keychain
AIOS_SECRETS_EXPOSED=false
# Opcional. Use apenas na sua maquina local e nunca versionar o arquivo real.
# AIOS_COMMUNITY_RUNTIME_API_KEY=cole-o-token-local-aqui

# Opcao Product Owner com OpenAI API autorizada.
# Para usar gpt-4o, gpt-5.2-codex ou gpt-5.5, troque AIOS_CHAT_PROVIDER
# para openai_api_authorized no arquivo .env.local.private real e configure:
# AIOS_CHAT_PROVIDER=openai_api_authorized
# AIOS_ALLOW_OPENAI_API_RUNTIME=true
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL=gpt-5.2-codex
# OPENAI_MODEL=gpt-5.5
# OPENAI_API_KEY=cole-a-chave-local-aqui
# OPENAI_PROJECT_ID=
# OPENAI_ORG_ID=

# Opcao padrao sem OpenAI API key no AIOS: Codex CLI local autenticado.
# Rode `codex login` fora do AIOS se ainda nao estiver autenticado.

# Opcao AIOS-native sem API, sem auth.json e sem endpoint externo:
# AIOS_CHAT_PROVIDER=aios_native_runtime
# AIOS_NATIVE_RUNTIME_ENABLED=true
# AIOS_NATIVE_RUNTIME_MODEL=aios-native-fabric-v1

# Opcao local OpenAI-compatible, se Ollama ou outro servidor estiver instalado:
# AIOS_CHAT_PROVIDER=community_wrapper_runtime
# AIOS_ALLOW_COMMUNITY_RUNTIME=true
# AIOS_COMMUNITY_RUNTIME_BASE_URL=http://127.0.0.1:11434/v1
# AIOS_COMMUNITY_RUNTIME_MODEL_ID=gpt-oss:20b
