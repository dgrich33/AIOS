AIOS_DATABASE_URL=postgresql+psycopg2://aios:aios_password@postgres:5432/aios
AIOS_REDIS_URL=redis://redis:6379/0
AIOS_JWT_SECRET=change-me-for-non-demo-use
AIOS_VAULT_URL=http://vault:8200
AIOS_VAULT_TOKEN=local-dev-token-only
VITE_AIOS_API_URL=http://localhost:8000

# RC16 Runtime Binding Gate - exemplos sem segredo real
AIOS_OFFICIAL_SANDBOX_PROVIDER=openai_codex
AIOS_OFFICIAL_CODEX_RUNTIME_ENDPOINT=
AIOS_OFFICIAL_CODEX_SERVICE_TOKEN=
AIOS_OFFICIAL_CODEX_TENANT_ID=
AIOS_OFFICIAL_SANDBOX_ENVIRONMENT_ID=
AIOS_OFFICIAL_SANDBOX_SECRET_STORE=vault
AIOS_OFFICIAL_SANDBOX_LIVE_ENABLED=false

# Alternativa OpenAI API Platform
OPENAI_BASE_URL=https://api.openai.com/v1
